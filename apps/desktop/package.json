{
  "name": "@meshdiff/desktop",
  "private": true,
  "version": "0.0.1",
  "description": "Meshdiff Desktop: a free local client for comparing 3D model versions",
  "author": "Projscope",
  "main": "dist/main.cjs",
  "scripts": {
    "build:renderer": "npm run build:desktop --workspace @meshdiff/web",
    "build:main": "node scripts/build.mjs",
    "build": "npm run build:renderer && npm run build:main",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --win",
    "smoke": "node tests/smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "electron-updater": "6.8.11",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.3",
    "ulid": "^2.4.0",
    "vitest": "^4.1.12"
  }
}
